# Origin serving the pack zips in production, and the source of live
# download counts (GitHub's release-asset download_count).
#
# Leave unset locally: the download buttons then read from public/downloads/,
# which Vite serves during dev, and the site hides download totals.
#
# In the Cloudflare Pages project, set this to the GitHub release download
# base printed by `npm run packs:upload`, e.g.
# VITE_CDN_BASE=https://github.com/iraqies/1.8packs/releases/download/packs

# Repo that holds the pack zips as release assets. Must be public.
GH_REPO=iraqies/1.8packs

# Release tag the zips are attached to. Defaults to "packs".
# GH_TAG=packs

# Set if the site is not on 1-8packs.pages.dev, so canonical URLs and the
# sitemap match the real hostname.
# VITE_SITE_URL=https://1-8packs.pages.dev
